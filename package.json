{
  "name": "parsnip",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Cache-preserving context manager for OpenCode V2 (server plugin)",
  "scripts": {
    "test": "node --test 'server/**/*.test.ts'",
    "test:bench": "node --test 'bench/**/*.test.ts'",
    "bench": "node bench/run.ts",
    "compare": "node bench/compare.ts",
    "eval": "node bench/eval.ts",
    "eval:export": "node bench/export-facts.ts",
    "savings": "node bench/read-savings.ts",
    "sweep": "node bench/threshold.ts"
  },
  "devDependencies": {
    "@opencode/plugin": "2.0.22"
  }
}
